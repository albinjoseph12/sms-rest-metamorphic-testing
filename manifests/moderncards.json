{
 "id": "moderncards",
 "repo": "modern-python/fastapi-sqlalchemy-template",
 "app": "app.application:build_app",
 "port": 9004,
 "python": "3.11",
 "db": "postgres",
 "db_name": "sms_moderncards",
 "deps": {
  "kind": "list",
  "packages": [
   "fastapi",
   "lite-bootstrap[fastapi-all]",
   "modern-di-fastapi>=2,<3",
   "advanced-alchemy",
   "pydantic-settings",
   "uvicorn",
   "alembic",
   "psycopg2-binary",
   "sqlalchemy[asyncio]",
   "asyncpg",
   "opentelemetry-instrumentation-asyncpg",
   "opentelemetry-instrumentation-sqlalchemy"
  ]
 },
 "env": {
  "DB_DSN": "postgresql+asyncpg://acb:acb@localhost:5432/sms_moderncards",
  "SERVICE_ENVIRONMENT": "test",
  "DATABASE_URL": "postgresql+asyncpg://acb:acb@localhost:5432/sms_moderncards"
 },
 "migrate": [
  "alembic upgrade head"
 ]
}